SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_HOSTNAME=smooth-operator.online
INBOUND_DOMAIN=smooth-operator.online
API_URL=http://127.0.0.1:3100
INTERNAL_SECRET=<redacted>
SPOOL_DIR=/var/lib/mailmint/spool
SPF_ENABLED=true
DKIM_ENABLED=true
DMARC_ENABLED=true
LOG_LEVEL=info
TLS_CERT_PATH=/etc/mailmint/tls/smtpd.crt
TLS_KEY_PATH=/etc/mailmint/tls/smtpd.key
